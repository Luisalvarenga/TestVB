<%@ Master Language="VB"
    AutoEventWireup="false"
    CodeBehind="Site.Master.vb"
    Inherits="TestVB.SiteMaster" %>

<!DOCTYPE html>

<html lang="es">

<head runat="server">

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1" />

    <title>
        <asp:ContentPlaceHolder
            ID="TitleContent"
            runat="server">
            Prueba Técnica - Gestión de Clientes
        </asp:ContentPlaceHolder>
    </title>

    <!-- Bootstrap 5 -->
    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet" />

    <link
        rel="stylesheet"
        href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <asp:ContentPlaceHolder
        ID="HeadContent"
        runat="server">
    </asp:ContentPlaceHolder>

</head>

<body class="bg-light">

<form id="formMaster" runat="server" class="d-flex flex-column min-vh-100">

    <nav class="navbar navbar-dark bg-primary shadow-sm">

        <div class="container">

            <a
                class="navbar-brand fw-semibold"
                href="<%= ResolveUrl("~/Clientes.aspx") %>">

                Gestión de Clientes

            </a>

            <asp:PlaceHolder
                ID="phUsuario"
                runat="server"
                Visible="False">

                <div class="d-flex align-items-center gap-3">

                    <asp:Label
                        ID="lblUsuario"
                        runat="server"
                        CssClass="text-white">
                    </asp:Label>

                    <a
                        href="<%= ResolveUrl("~/Logout.aspx") %>"
                        class="btn btn-outline-light btn-sm">

                        Cerrar sesión

                    </a>

                </div>

            </asp:PlaceHolder>

        </div>

    </nav>


<main class="container py-4 flex-grow-1">

        <asp:ContentPlaceHolder
            ID="MainContent"
            runat="server">
        </asp:ContentPlaceHolder>

    </main>


    <footer class="border-top bg-white py-3 mt-auto">

        <div class="container text-center text-muted small">

            Prueba Técnica - Gestión de Clientes

        </div>

    </footer>

</form>

<script
    src="<%= ResolveUrl("~/Scripts/site.js") %>">
</script>
<script
    src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js">
</script>

</body>

</html>